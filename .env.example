# Do not edit by hand: run ./scripts/keys.sh in your own Terminal. It writes .env.local (git ignored).
# Claude never reads .env.local.
# Server only unless prefixed NEXT_PUBLIC_.

# Anthropic (hackathon key: product and evals only)
ANTHROPIC_API_KEY=

# Sarvam AI (speech: Saaras v4 STT, Bulbul v3 TTS, kn-IN)
SARVAM_API_KEY=

# Supabase (hosted project; values are project scoped, never an account wide token, D30)
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# secret key (sb_secret_...) or legacy service_role key; server only
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string with password; used only by pnpm db:push, never by the app or Vercel
SUPABASE_DB_URL=

# Budget guard (USD)
AI_BUDGET_USD_CAP=350
AI_DAILY_USD_CAP=25
AI_QUESTIONS_PER_SESSION_PER_HOUR=30

# App
NEXT_PUBLIC_APP_URL=http://localhost:3070
DEMO_MODE=false

# Accounts (not secret)
PARAMPARA_GH_USER=buildrocketlabs

# Limits and switches (added 28 Oct)
TALK_VOICE_DAILY_CAP=2000
AI_SAMPLE_QUESTIONS_PER_HOUR=150
AI_NAME_CHECK=
AI_TRIAGE_NAME_CHECK=1
# Public URL used in invites and QR codes (falls back to the Vercel production URL)
PARAMPARA_PUBLIC_URL=

# Evals and tests (developer only; never needed in production)
# AI_REPLAY=1           replay recorded model calls, spend nothing
# AI_RECORD=1           record new calls into the eval cache
# LIVE_EVALS=1          allow paid live eval runs
# AI_ANSWERER_MODEL=    override the answerer model for comparisons
# AUDITION_PACE=1.0     speech pace for the voice audition
# DB_CHECK_URL=         throwaway Postgres for pnpm db:check (never the hosted project)
# PW_BASE_URL=          Playwright target (default local), PW_PORT, PW_FIXTURE=1, STORY_WIDTH
