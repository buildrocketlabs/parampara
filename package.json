{
  "name": "parampara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3070",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:shots": "playwright test --project=shots",
    "evals": "vitest run --config vitest.evals.config.ts",
    "evals:live": "LIVE_EVALS=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.evals.config.ts",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "seed:library": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-sample-library.mjs",
    "seed:pulse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-pulse.mjs",
    "db:push": "bash scripts/db-push.sh",
    "format": "prettier --write .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:check": "bash scripts/db-check.sh",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "invite": "node --env-file-if-exists=.env.local scripts/invite.mjs",
    "add:change": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/add-change.mjs",
    "ai:calls": "node --env-file-if-exists=.env.local scripts/ai-calls.mjs",
    "tidy:queue": "node --env-file-if-exists=.env.local scripts/tidy-sample-queue.mjs",
    "field:numbers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/field-numbers.mjs",
    "field:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/field-status.mjs",
    "kannada:review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/kannada-review.mjs",
    "warm:chips": "PW_BASE_URL=${PW_BASE_URL:-https://parampara-eta.vercel.app} playwright test --project=warm --workers=1",
    "latency:live": "PW_BASE_URL=${PW_BASE_URL:-https://parampara-eta.vercel.app} LATENCY_LABEL=${LATENCY_LABEL:-after} playwright test --project=latency --workers=1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.75",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "ai": "7.0.131",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lean-qr": "2.7.4",
    "lucide-react": "1.50.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12"
  }
}
